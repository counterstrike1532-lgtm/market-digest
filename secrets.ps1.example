# Copy to secrets.ps1 and fill in your keys (never commit secrets.ps1).
# ASCII only on purpose: Windows PowerShell 5.1 misreads UTF-8 files without BOM.
#
# GEMINI_API_KEY     https://aistudio.google.com  ->  Get API key
# GEMINI_MODEL       Optional comma-separated model list override
# TELEGRAM_BOT_TOKEN Telegram: message @BotFather  ->  /newbot
# TELEGRAM_CHAT_ID   message your bot, then open in a browser:
#                    https://api.telegram.org/bot<TOKEN>/getUpdates
#                    and find  "chat":{"id":NUMBER
# FRED_API_KEY       Optional FRED API key
# FT_IMAP_USER       Gmail/IMAP address receiving forwarded FT newsletters
# FT_IMAP_PASSWORD   App Password for FT_IMAP_USER
# FT_FORWARDER_EMAIL Optional Outlook address forwarding FT emails

$env:GEMINI_API_KEY        = ""
$env:GEMINI_MODEL          = ""
$env:TELEGRAM_BOT_TOKEN    = ""
$env:TELEGRAM_CHAT_ID      = ""
$env:FRED_API_KEY          = ""

$env:FT_IMAP_HOST          = "imap.gmail.com"
$env:FT_IMAP_PORT          = "993"
$env:FT_IMAP_USER          = ""
$env:FT_IMAP_PASSWORD      = ""
$env:FT_IMAP_FOLDER        = "INBOX"
$env:FT_FORWARDER_EMAIL    = ""
$env:FT_LOOKBACK_HOURS     = "36"
$env:FT_MAX_DRAFTS_PER_RUN = "2"
